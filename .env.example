# Copy to .env and fill in. Supabase → Project Settings → API Keys → "Publishable key".
# The publishable key is public by design (it ends up in the JS bundle) and is safe ONLY with RLS on every table.
# NEVER put a secret key (sb_secret_...) or the service_role key here or anywhere in this repo.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
